<Project Sdk="Godot.NET.Sdk/4.6.3">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <GodotGenerateBindings>false</GodotGenerateBindings>
        <GodotDisableAssemblyReload>false</GodotDisableAssemblyReload>
        <UseSharedCompilation>false</UseSharedCompilation>
        
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="Generators/Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Generators/**" />
    </ItemGroup>
</Project>